{
  "Mongo": {
    "Database": "campus_records"
  },
  "Seed": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Monitoring": {
    "Enabled": true
  },
  "ChangeStreams": {
    "Enabled": false
  },
  "Backup": {
    "Enabled": false,
    "IntervalHours": 24,
    "RetentionCount": 7
  }
}
